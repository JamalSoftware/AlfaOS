# Environment variables
# Copy this file to .env and fill in the real values.
# Never commit the real .env file.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://alfaos:alfaos_dev_password@localhost:5432/alfaos?schema=public"

# Secret used to sign session tokens (JWT). Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Session cookie name
SESSION_COOKIE_NAME="alfaos_session"

# Comma-separated list of allowed hosts for the dev server (optional)
