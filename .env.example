# Environment variables
# Copy this file to .env and fill in the real values.
# Never commit the real .env file.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://alfaos:alfaos_dev_password@localhost:5432/alfaos?schema=public"

# Secret used to sign session tokens (JWT).
# - Must have at least 32 characters.
# - In production, must NOT be the default value below (validation fails fast).
# Generate a strong one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Session cookie name
SESSION_COOKIE_NAME="alfaos_session"

# --- Same-Origin / CSRF (opcional) ---
#
# APP_ORIGINS: allowlist explícita de origens da aplicação, separadas por
# vírgula. É a política ESTRITA e a recomendada em produção: com ela
# configurada, a origem da requisição precisa estar na lista e nenhum
# cabeçalho da requisição participa da decisão.
#
# Vazia (o padrão), o AlfaOS compara `Origin` com o `Host` que o navegador
# endereçou — o que faz desenvolvimento por `localhost`, por IP de LAN e
# por nome de máquina funcionarem sem configuração nenhuma.
# APP_ORIGINS="https://app.alfaos.com.br,https://alfaos.com.br"
#
# TRUST_PROXY_HEADERS: só ligue quando existir um proxy reverso na frente
# que SOBRESCREVE `X-Forwarded-Host`. Ligado sem proxy, qualquer cliente
# passa a declarar o host que quiser — é Host Header Injection pela porta
# da frente. Desligado por padrão.
# TRUST_PROXY_HEADERS="false"

# --- Trava de release do SGP (opcional, padrão mostrado) ---
#
# SGP_ACTIVATION_ENABLED: libera a ATIVAÇÃO do ERP SGP nesta instalação.
# Desligada por padrão, e ausente também é desligada.
#
# O SGP autentica e é ativável desde a SGP-1, e nunca foi exercitado contra
# uma instalação real. Ativá-lo hoje faz toda a superfície ERP da empresa
# responder NOT_SUPPORTED — busca de cliente, diagnóstico, chamados —, sem
# aviso. Testar a conexão continua liberado: é diagnóstico, e é o que a
# homologação precisa fazer.
#
# Comparação EXATA com "true": "1", "yes" e "TRUE" não liberam. Ligue
# deliberadamente, depois da homologação. Ver docs/SECURITY.md §8.18.
# SGP_ACTIVATION_ENABLED="false"

# --- Login rate limiting (optional, defaults shown) ---
# Absent = default. Present but not a plain integer in range = the app REFUSES
# to start (RC-SEC-01): a typo must never switch brute-force protection off.
# Maximum failed login attempts per e-mail before temporary block. 1..1000.
LOGIN_MAX_FAILED_ATTEMPTS="5"
# Time window (seconds) used to count failures. 60..604800.
LOGIN_WINDOW_SECONDS="900"
# Maximum failed login attempts per IP before temporary block. 1..100000.
LOGIN_MAX_FAILED_ATTEMPTS_BY_IP="20"
#
# NOTE: LOGIN_MAX_FAILED_ATTEMPTS_GLOBAL was REMOVED in
# v0.2.2-pre-v03-hardening and is no longer read. It capped failed logins across
# the whole deployment, which let any anonymous caller (random e-mails, no valid
# account needed) shut login down for every tenant for a full window. The CPU
# cost it was protecting against is now bounded directly — see the bcrypt
# admission gate below and docs/SECURITY.md §2.2.

# --- bcrypt admission gate (optional, defaults shown) ---
# Password hashing is CPU-bound and runs on the single Node thread that serves
# every tenant. These bound the damage a login flood can do:
#   BCRYPT_MAX_CONCURRENCY - hashes/comparisons allowed to run at once. Small on
#                            purpose (2-4); higher only spreads the same CPU
#                            over more requests and raises everyone's latency.
#   BCRYPT_MAX_QUEUE       - callers allowed to wait in FIFO order. Beyond this
#                            the request is refused immediately with 503 and
#                            zero CPU. Worst-case wait is roughly
#                            (QUEUE / CONCURRENCY) * 350ms — keep it under the
#                            client HTTP timeout.
# Back-pressure is instantaneous: it recovers as soon as the flood stops and
# leaves behind no state that can keep legitimate users out.
BCRYPT_MAX_CONCURRENCY="2"
BCRYPT_MAX_QUEUE="32"

# --- Trusted proxies (optional, default 0) ---
# Number of TRUSTED reverse proxies (CDN, load balancer, nginx, ...) that sit
# in front of the app and rewrite/append `X-Forwarded-For`.
#   0 (default) → `X-Forwarded-For` is IGNORED. Safe when the app is reached
#                 directly: a client cannot forge another client's IP.
#                 Where the runtime exposes no connection IP, the per-IP login
#                 limit is simply skipped (the per-e-mail limit still applies).
#   N >= 1      → the address written by the OUTERMOST trusted proxy is used,
#                 i.e. the entry N positions from the right of the header
#                 (same semantics as Express `trust proxy = N`).
# Set this to the REAL number of proxies. Too high trusts client-supplied
# entries (IP spoofing / rate-limit evasion); too low rate-limits your own
# proxy's address for every user. See docs/SECURITY.md.
# Present but not a plain non-negative integer ("abc", "1.5", "2abc", empty)
# = the app REFUSES to start (RC-1F-A). It used to fall back to 0 in silence.
# TRUSTED_PROXY_HOPS="0"

# --- Criptografia de credenciais de ERP (obrigatória para configurar tokens) ---
# Chave mestra AES-256-GCM usada para cifrar o token/API Key de cada empresa
# antes de gravar no banco. NUNCA é armazenada no banco e NUNCA vai para o Git.
#
# Deve decodificar (base64) para exatamente 32 bytes. Gere uma com:
#   openssl rand -base64 32
#
# Sem esta variável a aplicação funciona normalmente, mas salvar ou ler uma
# credencial de ERP falha de forma FECHADA (HTTP 503) — em nenhuma hipótese um
# token é gravado em texto puro como alternativa.
#
# Rotacionar esta chave invalida todas as credenciais já cifradas: elas
# precisarão ser reconfiguradas pelos ADMINs.
# ERP_CREDENTIAL_ENCRYPTION_KEY=""

# --- Criptografia de senhas de conexao do cliente (PPPoE) ---
# Chave AES-256-GCM usada para cifrar a senha PPPoE de cada conexao de
# cliente antes de gravar no banco. NUNCA e armazenada no banco e NUNCA vai
# para o Git.
#
# Deve decodificar (base64) para exatamente 32 bytes. Gere uma com:
#   openssl rand -base64 32
#
# CHAVE PROPRIA, separada da ERP_CREDENTIAL_ENCRYPTION_KEY, de proposito.
# As duas protegem coisas diferentes para publicos diferentes: um token de
# ERP e um segredo por empresa, manuseado por ADMINs; uma senha PPPoE e um
# segredo por cliente, lido por tecnicos em campo. O motivo decisivo e o
# alcance da rotacao: com uma chave so, rotacionar algo chamado "ERP"
# destruiria silenciosamente a senha de acesso de todos os clientes.
# Chaves separadas fazem o nome corresponder ao que a rotacao quebra.
#
# Sem esta variavel a aplicacao funciona normalmente, mas gravar ou revelar
# uma senha de conexao falha de forma FECHADA — em nenhuma hipotese uma
# senha e gravada em texto puro como alternativa.
#
# Presente e malformada (nao decodifica para 32 bytes), a aplicacao NAO sobe
# (RC-1F-A) — como a chave de ERP. A mensagem diz so o tamanho, nunca o valor.
#
# Rotacionar esta chave invalida todas as senhas de conexao ja cifradas:
# elas precisarao ser reconfiguradas.
# CUSTOMER_CREDENTIAL_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Push do Field — Firebase Cloud Messaging (NF-1)
# ---------------------------------------------------------------------------
#
# Credencial de CONTA DE SERVICO, lida somente pelo worker do outbox
# (`npm run outbox:work`). Nunca vai para o Flutter, nunca para o navegador e
# nunca para o runtime web: `outbox-handlers.ts` e alcancado apenas pelo
# worker, e e isso que mantem `firebase-admin` fora do bundle do Next.
#
# UM projeto Firebase para a plataforma inteira, e nao um por empresa. O
# isolamento entre tenants acontece no dominio — na consulta que escolhe os
# aparelhos —, e nao numa segunda credencial por cliente.
#
# AUSENCIA E SUPORTADA. Sem estas tres variaveis o AlfaOS sobe normalmente, os
# testes rodam, o build passa e o worker processa a fila: ele so nao entrega
# push, e diz isso uma vez no log. Push nunca foi o caminho critico.
#
# CONFIGURACAO PELA METADE nao liga nada. Definir duas das tres deixa o worker
# no provider inerte e registra QUAL variavel falta — quem definiu duas quis
# ligar o push, e o silencio faria a fila parecer saudavel enquanto nenhum
# tecnico recebe nada.
#
# A chave privada e multilinha. Guarde-a em UMA linha com `\n` escapado, que e
# como a maioria das hospedagens aceita valor multilinha; o codigo converte.
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
#
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# DIAG-AUTO-1 — verificacao automatica de conectividade
# ---------------------------------------------------------------------------
#
# O ciclo e um COMANDO, nao um daemon: `npm run diagnostics:refresh` roda UMA
# volta e sai. Quem o repete e o agendador do ambiente — o mesmo padrao do
# worker do outbox (`npm run outbox:work`), e pelos mesmos motivos: instancia
# unica, sem supervisor de processos, e um daemon morreria no deploy.
#
# CONTRATO DE AGENDAMENTO — PLANEJADO (RC-1F-A), NAO ativado em lugar nenhum:
#
#   * * * * *  cd <raiz-do-deploy> && npm run diagnostics:refresh
#
#   tick do agendador   1 min
#   alvo de frescor     5 min   (DIAGNOSTICS_REFRESH_TARGET_MS)
#   aviso na tela      10 min   (DIAGNOSTICS_STALE_AFTER_MS)
#
# Dois modos do MESMO comando:
#
#   npm run diagnostics:refresh                              volta normal — a do agendador
#   npm run diagnostics:refresh -- --customer-id <id>        UM cliente — validacao/suporte
#   npm run diagnostics:dry-run -- --customer-id <id>        previa: nada consultado nem escrito
#
# `<id>` e o id INTERNO do cliente no AlfaOS — nunca nome, nunca id do ERP. O
# filtro estreita a selecao e mais nada: o cliente ainda precisa de vinculo
# ativo e de verificacao vencida, e passa pela mesma reserva, prazo e escrita.
# NAO e "forcar": cliente recente, reservado ou desligado nao e consultado, e
# nenhum outro e escolhido no lugar. Flag malformada sai com 2.
#
# O tick e MAIS CURTO que o alvo de proposito. Com tick igual ao alvo, quem foi
# verificado segundos depois de um disparo ainda nao venceu no seguinte, e a
# revisita real fica em ~10 min, na borda do aviso. Tick de 1 minuto NAO
# consulta cada cliente a cada minuto: quem esta dentro do alvo nao e elegivel,
# e voltas sobrepostas nao repetem chamada — a reserva confere de novo se o
# cliente acabou de ser verificado. A revisita fica entre 5 e 6 min.
#
# SEM o agendamento, nada se atualiza sozinho — e a tela AVISA, porque a
# verificacao envelhece e o aviso "Leitura desatualizada" aparece. O sistema
# envelhece em publico, em vez de afirmar um estado que ninguem confirmou.
#
# Saida do comando: 0 a volta rodou (falha de provider e contagem), 1 a volta
# quebrou, 2 configuracao invalida — nada foi consultado, e a mensagem diz qual
# variavel.
#
# As quatro variaveis abaixo sao OPCIONAIS. Valor invalido DERRUBA a subida do
# comando em vez de virar NaN e mudar o comportamento em silencio — a mesma regra
# que a RC-1B aplicou as variaveis de login.
#
# A POLITICA de frescor: duas grandezas DISTINTAS, num lugar so
# (`src/lib/connectivity-policy.ts`). O ciclo e a tela leem as duas daqui — se
# cada um lesse a sua, alongar o alvo deixaria a tela avisando cedo demais.
#
# Alvo de reverificacao por conexao. Padrao: 300000 (5 min).
# DIAGNOSTICS_REFRESH_TARGET_MS="300000"
#
# A partir de quando a tela avisa "Leitura desatualizada". Padrao: 600000
# (10 min). NAO pode ser menor que o alvo: toda verificacao nasceria atrasada,
# e a configuracao e recusada na subida.
# DIAGNOSTICS_STALE_AFTER_MS="600000"
#
# Teto de VERIFICACOES QUE CHEGAM AO PROVIDER por execucao. Padrao: 300. Existe
# para o comando terminar e o agendador poder repetir; sobrou trabalho, o log
# avisa. Nao contam: reservado por outro ciclo, recem-verificado, empresa sem
# diagnostico. Inteiro de 1 a 1000 (teto decidido pelo dono, RC-1F-A); fora da
# faixa, o comando sai com codigo 2.
# DIAGNOSTICS_REFRESH_BATCH_LIMIT="300"
#
# Verificacoes simultaneas. Padrao: 6, deliberadamente conservador — o
# provider e consultado UM cliente por verificacao (nao ha lote na interface), o
# prazo de cada uma e 8 s, e uma verificacao ReceitaNet sao ate DUAS requisicoes
# em sequencia. O prazo cancela a requisicao em voo, entao 6 e tambem o teto de
# requisicoes simultaneas. Inteiro de 1 a 12 (teto decidido pelo dono, RC-1F-A).
# Subir isto dentro da faixa e decisao de operacao, MEDIDA contra o provider
# real; a capacidade do provider ainda nao foi medida.
# DIAGNOSTICS_REFRESH_CONCURRENCY="6"
#
# ---------------------------------------------------------------------------
# Worker do outbox
# ---------------------------------------------------------------------------
#
# Eventos reivindicados por execucao de `npm run outbox:work`. Padrao: 50.
# Inteiro de 1 a 500 (teto decidido pelo dono); invalido faz o worker sair com
# codigo 2 dizendo qual variavel, sem reivindicar nada (RC-1F-A). Antes, "0"
# rodava sem processar nada e a fila parava em silencio.
# OUTBOX_BATCH_LIMIT="50"
