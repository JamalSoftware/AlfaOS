# Environment variables
# Copy this file to .env and fill in the real values.
# Never commit the real .env file.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://alfaos:alfaos_dev_password@localhost:5432/alfaos?schema=public"

# Secret used to sign session tokens (JWT).
# - Must have at least 32 characters.
# - In production, must NOT be the default value below (validation fails fast).
# Generate a strong one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Session cookie name
SESSION_COOKIE_NAME="alfaos_session"

# Comma-separated list of allowed hosts for the dev server (optional)

# --- Login rate limiting (optional, defaults shown) ---
# Maximum failed login attempts per e-mail before temporary block.
LOGIN_MAX_FAILED_ATTEMPTS="5"
# Time window (seconds) used to count failures.
LOGIN_WINDOW_SECONDS="900"
# Maximum failed login attempts per IP before temporary block.
LOGIN_MAX_FAILED_ATTEMPTS_BY_IP="20"
#
# NOTE: LOGIN_MAX_FAILED_ATTEMPTS_GLOBAL was REMOVED in
# v0.2.2-pre-v03-hardening and is no longer read. It capped failed logins across
# the whole deployment, which let any anonymous caller (random e-mails, no valid
# account needed) shut login down for every tenant for a full window. The CPU
# cost it was protecting against is now bounded directly — see the bcrypt
# admission gate below and docs/SECURITY.md §2.2.

# --- bcrypt admission gate (optional, defaults shown) ---
# Password hashing is CPU-bound and runs on the single Node thread that serves
# every tenant. These bound the damage a login flood can do:
#   BCRYPT_MAX_CONCURRENCY - hashes/comparisons allowed to run at once. Small on
#                            purpose (2-4); higher only spreads the same CPU
#                            over more requests and raises everyone's latency.
#   BCRYPT_MAX_QUEUE       - callers allowed to wait in FIFO order. Beyond this
#                            the request is refused immediately with 503 and
#                            zero CPU. Worst-case wait is roughly
#                            (QUEUE / CONCURRENCY) * 350ms — keep it under the
#                            client HTTP timeout.
# Back-pressure is instantaneous: it recovers as soon as the flood stops and
# leaves behind no state that can keep legitimate users out.
BCRYPT_MAX_CONCURRENCY="2"
BCRYPT_MAX_QUEUE="32"

# --- Trusted proxies (optional, default 0) ---
# Number of TRUSTED reverse proxies (CDN, load balancer, nginx, ...) that sit
# in front of the app and rewrite/append `X-Forwarded-For`.
#   0 (default) → `X-Forwarded-For` is IGNORED. Safe when the app is reached
#                 directly: a client cannot forge another client's IP.
#                 Where the runtime exposes no connection IP, the per-IP login
#                 limit is simply skipped (the per-e-mail limit still applies).
#   N >= 1      → the address written by the OUTERMOST trusted proxy is used,
#                 i.e. the entry N positions from the right of the header
#                 (same semantics as Express `trust proxy = N`).
# Set this to the REAL number of proxies. Too high trusts client-supplied
# entries (IP spoofing / rate-limit evasion); too low rate-limits your own
# proxy's address for every user. See docs/SECURITY.md.
# TRUSTED_PROXY_HOPS="0"

# --- Criptografia de credenciais de ERP (obrigatória para configurar tokens) ---
# Chave mestra AES-256-GCM usada para cifrar o token/API Key de cada empresa
# antes de gravar no banco. NUNCA é armazenada no banco e NUNCA vai para o Git.
#
# Deve decodificar (base64) para exatamente 32 bytes. Gere uma com:
#   openssl rand -base64 32
#
# Sem esta variável a aplicação funciona normalmente, mas salvar ou ler uma
# credencial de ERP falha de forma FECHADA (HTTP 503) — em nenhuma hipótese um
# token é gravado em texto puro como alternativa.
#
# Rotacionar esta chave invalida todas as credenciais já cifradas: elas
# precisarão ser reconfiguradas pelos ADMINs.
# ERP_CREDENTIAL_ENCRYPTION_KEY=""

# --- Criptografia de senhas de conexao do cliente (PPPoE) ---
# Chave AES-256-GCM usada para cifrar a senha PPPoE de cada conexao de
# cliente antes de gravar no banco. NUNCA e armazenada no banco e NUNCA vai
# para o Git.
#
# Deve decodificar (base64) para exatamente 32 bytes. Gere uma com:
#   openssl rand -base64 32
#
# CHAVE PROPRIA, separada da ERP_CREDENTIAL_ENCRYPTION_KEY, de proposito.
# As duas protegem coisas diferentes para publicos diferentes: um token de
# ERP e um segredo por empresa, manuseado por ADMINs; uma senha PPPoE e um
# segredo por cliente, lido por tecnicos em campo. O motivo decisivo e o
# alcance da rotacao: com uma chave so, rotacionar algo chamado "ERP"
# destruiria silenciosamente a senha de acesso de todos os clientes.
# Chaves separadas fazem o nome corresponder ao que a rotacao quebra.
#
# Sem esta variavel a aplicacao funciona normalmente, mas gravar ou revelar
# uma senha de conexao falha de forma FECHADA — em nenhuma hipotese uma
# senha e gravada em texto puro como alternativa.
#
# Rotacionar esta chave invalida todas as senhas de conexao ja cifradas:
# elas precisarao ser reconfiguradas.
# CUSTOMER_CREDENTIAL_ENCRYPTION_KEY=""
