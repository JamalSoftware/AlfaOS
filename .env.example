# Environment variables
# Copy this file to .env and fill in the real values.
# Never commit the real .env file.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://alfaos:alfaos_dev_password@localhost:5432/alfaos?schema=public"

# Secret used to sign session tokens (JWT).
# - Must have at least 32 characters.
# - In production, must NOT be the default value below (validation fails fast).
# Generate a strong one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Session cookie name
SESSION_COOKIE_NAME="alfaos_session"

# Comma-separated list of allowed hosts for the dev server (optional)

# --- Login rate limiting (optional, defaults shown) ---
# Maximum failed login attempts per e-mail before temporary block.
LOGIN_MAX_FAILED_ATTEMPTS="5"
# Time window (seconds) used to count failures.
LOGIN_WINDOW_SECONDS="900"
# Maximum failed login attempts per IP before temporary block.
LOGIN_MAX_FAILED_ATTEMPTS_BY_IP="20"
# Maximum failed login attempts across the WHOLE deployment (all e-mails, all
# IPs) inside the same window. Last-resort brake: an anonymous flood using a
# fresh random e-mail per request never trips the per-e-mail limit, and the
# per-IP limit does not apply when no trusted client IP exists (the default
# without TRUSTED_PROXY_HOPS). Each such request would otherwise pay a full
# bcrypt cost-12 (~350ms of synchronous CPU) and starve every tenant.
# While tripped, ALL logins get 429 until the window slides — raise it if a
# large deployment legitimately produces more than this many failures per
# window, but keep it far below the request rate that saturates a CPU core.
LOGIN_MAX_FAILED_ATTEMPTS_GLOBAL="200"

# --- Trusted proxies (optional, default 0) ---
# Number of TRUSTED reverse proxies (CDN, load balancer, nginx, ...) that sit
# in front of the app and rewrite/append `X-Forwarded-For`.
#   0 (default) → `X-Forwarded-For` is IGNORED. Safe when the app is reached
#                 directly: a client cannot forge another client's IP.
#                 Where the runtime exposes no connection IP, the per-IP login
#                 limit is simply skipped (the per-e-mail limit still applies).
#   N >= 1      → the address written by the OUTERMOST trusted proxy is used,
#                 i.e. the entry N positions from the right of the header
#                 (same semantics as Express `trust proxy = N`).
# Set this to the REAL number of proxies. Too high trusts client-supplied
# entries (IP spoofing / rate-limit evasion); too low rate-limits your own
# proxy's address for every user. See docs/SECURITY.md.
# TRUSTED_PROXY_HOPS="0"
