<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Tres permissoes, e cada uma existe porque uma funcionalidade REAL
        precisa dela agora.

        Ate a v0.9 INTERNET era a unica. A v0.10 acrescenta camera e
        localizacao porque a execucao em campo passou a exigir evidencia
        fotografica e confirmacao de ponto — nao "para depois". Pedir permissao
        antes de existir a funcionalidade treina o usuario a aceitar sem ler, e
        no dia em que ela for necessaria o consentimento ja perdeu o
        significado.

        Discar e navegar continuam sem permissao: sao Intent para apps
        externos (`tel:`, Maps, Waze).
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Camera: evidencia fotografica do atendimento (PRD 162).
    -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!--
        Localizacao ENQUANTO EM USO, e so.

        ACCESS_BACKGROUND_LOCATION NAO e pedida e nao deve ser acrescentada: o
        AlfaOS nao rastreia tecnico fora do atendimento, e a §138 trata
        localizacao de pessoa como dado sensivel. Rastreamento continuo e outra
        capability, com outro consentimento — nao um efeito colateral desta.

        COARSE acompanha FINE porque o Android 12+ deixa o usuario conceder
        apenas a aproximada; sem declarar as duas, negar a precisa negaria
        tudo, e um ponto aproximado ainda serve para registrar chegada.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!--
        O aparelho NAO precisa ter camera nem GPS para o aplicativo instalar.

        Sem isto o Play Store esconderia o app de qualquer aparelho sem os dois
        — e o tecnico que usa um tablet sem camera perderia o acesso a lista de
        OS inteira por causa de uma funcionalidade opcional.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <application
        android:label="AlfaOS Field"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
        Consultas de pacote que o aplicativo precisa fazer.

        No Android 11+ `canLaunchUrl` devolve false para um esquema que nao
        esteja declarado aqui, mesmo com o app instalado. Sem estas entradas os
        botoes de ligar e navegar apareceriam desabilitados num aparelho que
        tem discador, Google Maps e Waze — que e o caso de qualquer celular de
        tecnico.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <!-- Waze usa esquema proprio. -->
        <package android:name="com.waze"/>
        <package android:name="com.google.android.apps.maps"/>
    </queries>
</manifest>
