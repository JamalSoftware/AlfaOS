generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessProfile {
  ADMIN
  DISPATCHER
  TECHNICIAN
}

enum ERPProvider {
  MOCK
  RECEITANET
}

enum ServiceOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceOrderStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceOrderSource {
  MANUAL
  IMPORTED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  document  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  auditLogs     AuditLog[]
  erpIntegration ERPIntegration?
  customers     Customer[]
  technicians   Technician[]
  serviceOrders ServiceOrder[]
  serviceOrderEvents ServiceOrderEvent[]

  @@map("companies")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model User {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String        @unique
  passwordHash String
  profile      AccessProfile @default(TECHNICIAN)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  auditLogs AuditLog[]
  technicians Technician[]
  serviceOrderEvents ServiceOrderEvent[]

  @@index([companyId])
  @@index([email])
  @@index([companyId, profile, active])
  @@map("users")
}

model Customer {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalProvider String?
  externalId       String?
  name             String
  document         String?
  phone            String?
  secondaryPhone   String?
  email            String?
  address          String?
  number           String?
  complement       String?
  district         String?
  city             String?
  state            String?
  zipCode          String?
  latitude         Decimal?
  longitude        Decimal?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceOrders ServiceOrder[]

  @@unique([companyId, externalProvider, externalId])
  @@index([companyId, name])
  @@index([companyId, document])
  @@index([companyId, active])
  @@map("customers")
}

model Technician {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceOrders ServiceOrder[]

  @@unique([userId])
  @@index([companyId])
  @@index([companyId, active])
  @@map("technicians")
}

model ServiceOrder {
  id               String              @id @default(cuid())
  companyId        String
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalProvider String?
  externalId       String?
  externalNumber   String?
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technicianId     String?
  technician       Technician?         @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  type             String
  subtype          String?
  description      String              @db.Text
  priority         ServiceOrderPriority @default(NORMAL)
  status           ServiceOrderStatus  @default(PENDING)
  source           ServiceOrderSource  @default(MANUAL)
  scheduledAt      DateTime?
  assignedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  /// Optimistic-lock token. Bumped on every write that changes the order, and
  /// used as the compare-and-set predicate by `assignTechnician`. `updatedAt`
  /// cannot serve this purpose: Prisma maps DateTime to `timestamp(3)`, so two
  /// writes in the same millisecond both match and one is silently lost.
  version          Int                 @default(0)

  events ServiceOrderEvent[]

  @@unique([companyId, externalProvider, externalId])
  @@index([companyId, status])
  @@index([companyId, priority])
  @@index([companyId, scheduledAt])
  @@index([companyId, createdAt])
  @@index([customerId])
  @@index([technicianId])
  @@map("service_orders")
}

model ServiceOrderEvent {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  event          String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([serviceOrderId, createdAt])
  @@index([companyId, createdAt])
  @@map("service_order_events")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model ERPIntegration {
  id             String      @id @default(cuid())
  companyId      String      @unique
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider       ERPProvider @default(MOCK)
  name           String      @default("Mock ERP")
  baseUrl        String?
  apiKey         String?
  config         Json?
  enabled        Boolean     @default(false)
  lastTestedAt   DateTime?
  lastTestStatus String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("erp_integrations")
}
