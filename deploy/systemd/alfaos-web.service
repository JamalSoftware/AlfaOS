# AlfaOS — processo web (Next.js) — RC-1F-B
#
# MODELO. Copie para /etc/systemd/system/alfaos-web.service e ajuste apenas os
# caminhos, se o layout do host for outro. Não contém domínio, IP nem segredo:
# tudo o que é sensível vive em EnvironmentFile, fora do Git.
#
#   install -m 0644 deploy/systemd/alfaos-web.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now alfaos-web
#
# UMA instância, e isso é contrato (docs/DEPLOYMENT.md): o limitador de login,
# o de diagnóstico e a fila de bcrypt vivem na memória do processo. Duas
# instâncias dobram silenciosamente esses limites.

[Unit]
Description=AlfaOS web (Next.js)
Documentation=file:///opt/alfaos/current/docs/DEPLOYMENT.md
After=network-online.target postgresql.service
Wants=network-online.target
# Erro de configuração para de vez, em vez de inundar o log reiniciando: cinco
# partidas em cinco minutos e o serviço entra em failed, visível no status.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=alfaos
Group=alfaos
WorkingDirectory=/opt/alfaos/current
EnvironmentFile=/etc/alfaos/alfaos.env
# LOOPBACK, e isso é segurança, não estilo (`SEC-005`).
#
# `next start` sem `--hostname` escuta em 0.0.0.0: a porta 3000 fica acessível
# direto da rede, e quem chega por ali NÃO passa pelo Nginx. Com isso caem
# juntos o teto de corpo do proxy, o HTTPS e — o pior — a aritmética do
# limitador: `TRUSTED_PROXY_HOPS=1` supõe UM proxy que ACRESCENTA a
# `x-forwarded-for`, então numa requisição direta o cliente escolhe o IP que o
# limitador vai contar. O firewall é a segunda camada; esta é a primeira, e não
# depende de o operador ter acertado o `ufw`.
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
# Só falha reinicia. Uma parada pedida pelo operador continua parada.
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Privilégio mínimo: o processo não é root e só escreve onde precisa.
NoNewPrivileges=true
PrivateTmp=true
#
# `strict`, e não `full` — `SEC-011`.
#
# `ProtectSystem=full` deixa `/usr`, `/boot` e `/etc` só-leitura e **não toca
# `/opt`**, que é justamente onde o release mora. O processo podia reescrever o
# próprio código: um defeito que permitisse escrita de arquivo viraria execução
# persistente, sobrevivendo a restart e a `systemctl reload`, e o `.next` não
# corresponderia mais ao commit implantado.
#
# `strict` torna TODO o sistema de arquivos só-leitura e devolve a escrita
# apenas onde `ReadWritePaths` concede. O release fica imutável para quem o
# executa; o deploy continua escrevendo normalmente, porque ele roda fora deste
# serviço (§8 do runbook) e não herda estas restrições.
ProtectSystem=strict
ProtectHome=true
#
# O storage é o ÚNICO caminho gravável concedido.
#
# `PrivateTmp=true` já dá um `/tmp` próprio e gravável, então o Node tem onde
# escrever temporário sem que `/opt` precise ser liberado. `next start` não
# escreve no release: o `.next` é lido, e quem o produz é o `npm run build` do
# deploy.
ReadWritePaths=/srv/alfaos/storage

StandardOutput=journal
StandardError=journal
SyslogIdentifier=alfaos-web

[Install]
WantedBy=multi-user.target
