{
  "name": "workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "outbox:work": "node dist/scripts/outbox-worker.js",
    "evidence:cleanup": "node dist/scripts/evidence-cleanup.js",
    "dispatch:backfill": "node dist/scripts/dispatch-queue-backfill.js",
    "diagnostics:refresh": "node dist/scripts/connectivity-refresh.js",
    "diagnostics:dry-run": "node dist/scripts/connectivity-refresh.js --dry-run",
    "storage:audit": "node dist/scripts/photo-storage-audit.js",
    "build:worker": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "firebase-admin": "^14.3.0",
    "jose": "^6.2.9",
    "leaflet": "^1.9.4",
    "next": "15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.25",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
